<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/buttonYellowPressed" />
            <stroke android:width="2dp" android:color="@color/buttonAmber" />
            <corners android:radius="18dp" />
            <padding android:left="10dp" android:top="4dp" android:right="10dp" android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/buttonYellow" />
            <stroke android:width="2dp" android:color="@color/buttonAmber" />
            <corners android:radius="18dp" />
            <padding android:left="10dp" android:top="4dp" android:right="10dp" android:bottom="4dp" />
        </shape>
    </item>
</selector>